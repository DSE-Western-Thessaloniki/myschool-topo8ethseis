{
  "name": "myschool-topo8ethseis",
  "version": "1.0.0",
  "description": "Αυτοματοποίηση τοποθετήσεων εκπαιδευτικών στο σύστημα myschool",
  "main": "dist/desktop/main.js",
  "type": "module",
  "desktopName": "gr.sch.myschool.topo8ethseis",
  "scripts": {
    "compile": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/src/index.js 2>&1 | tee -a down.log",
    "ui": "node dist/src/index.js --no-run 2>&1 | tee -a down.log",
    "desktop": "npm run compile && electron .",
    "dist:linux": "npm run compile && electron-builder --linux --publish never",
    "dist:win": "npm run compile && electron-builder --win --publish never",
    "dist": "npm run compile && electron-builder --publish never"
  },
  "keywords": [],
  "author": "Theofilos Intzoglou <int.teo@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "console-stamp": "^3.0.2",
    "dotenv": "^18.0.0",
    "express": "^5.3.0",
    "puppeteer-core": "^25.16.0",
    "ws": "^8.22.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "mime-types": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "gr.sch.myschool.topo8ethseis",
    "productName": "MySchool Τοποθετήσεις",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/index.html",
      "public/styles.css",
      "package.json",
      "!**/.env",
      "!**/credentials.json",
      "!**/file.xlsx",
      "!**/template.xlsx",
      "!**/*.log",
      "!**/img/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "executableArgs": [
        "--ozone-platform=x11"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}