{
  "name": "myschool-topo8ethseis",
  "version": "1.0.0",
  "description": "Αυτοματοποίηση τοποθετήσεων εκπαιδευτικών στο σύστημα myschool",
  "main": "dist/desktop/main.js",
  "type": "module",
  "scripts": {
    "compile": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/src/index.js 2>&1 | tee -a down.log",
    "ui": "node dist/src/index.js --no-run 2>&1 | tee -a down.log",
    "desktop": "npm run compile && electron .",
    "dist:linux": "npm run compile && electron-builder --linux --publish never",
    "dist:win": "npm run compile && electron-builder --win --publish never",
    "dist": "npm run compile && electron-builder --publish never"
  },
  "keywords": [],
  "author": "Theofilos Intzoglou <int.teo@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "console-stamp": "^3.0.2",
    "dotenv": "^16.0.0",
    "express": "^4.22.3",
    "puppeteer-core": "^24.43.1",
    "ws": "^8.22.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^18.19.130",
    "@types/ws": "^8.18.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^4.8.2"
  },
  "build": {
    "appId": "gr.sch.myschool.topo8ethseis",
    "productName": "MySchool Τοποθετήσεις",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/index.html",
      "public/styles.css",
      "package.json",
      "!**/.env",
      "!**/credentials.json",
      "!**/file.xlsx",
      "!**/template.xlsx",
      "!**/*.log",
      "!**/img/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}